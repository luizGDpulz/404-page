---
import '../styles/global.css';
---

<!doctype html>
<html lang="pt-BR" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>404 — Página não encontrada</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body class="min-h-dvh flex flex-col items-center justify-center relative px-4 py-12">
    <div
      id="bg-glow"
      aria-hidden="true"
      class="pointer-events-none fixed top-1/2 left-1/2 w-[26rem] h-[26rem] opacity-75 transition-opacity duration-700"
    ></div>

    <main class="relative z-10 w-full max-w-xl text-center animate-content-expand">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-900/90 border border-zinc-800 text-xs font-mono text-zinc-400 mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full accent-dot animate-pulse"></span>
        <span>HTTP 404 // ROUTE_NOT_FOUND</span>
      </div>

      <h1 class="text-8xl sm:text-9xl font-black tracking-tighter bg-gradient-to-b from-white via-zinc-200 to-zinc-600 bg-clip-text text-transparent select-none leading-none transition-transform duration-500 ease-out hover:scale-[1.03]">
        404
      </h1>

      <h2 class="mt-5 text-xl sm:text-2xl font-semibold tracking-tight text-zinc-100">
        Parece que você se perdeu!
      </h2>

      <div class="mt-4 flex flex-col items-center">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-zinc-900/90 border border-zinc-800 font-mono text-xs sm:text-sm max-w-full shadow-sm">
          <span class="text-zinc-500 select-none font-semibold">GET</span>
          <code id="domain-badge" class="accent-text font-medium break-all">...</code>
        </div>

        <div id="typo-wrapper" hidden class="mt-2.5">
          <a
            id="typo-link"
            href="#"
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-zinc-900/60 hover:bg-zinc-900 border border-zinc-800/80 accent-border-hover text-xs text-zinc-400 hover:text-zinc-200 transition-all"
          >
            <span>💡 Quis dizer</span>
            <span id="typo-target" class="font-mono accent-text font-medium underline underline-offset-2"></span>
            <span>?</span>
          </a>
        </div>
      </div>

      <p
        id="error-message"
        class="mt-4 text-sm sm:text-base text-zinc-400 leading-relaxed max-w-md mx-auto"
      >
        O endereço que você buscou não existe ou eu quebrei alguma coisa!
      </p>

      <nav
        id="links-section"
        aria-label="Links úteis"
        hidden
        class="mt-9 flex flex-wrap items-center justify-center gap-3.5"
      >
        <a
          id="portfolio-btn"
          href="#"
          hidden
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-xl bg-zinc-100 hover:bg-white text-zinc-950 font-medium text-sm transition-all duration-200 shadow-sm hover:shadow-emerald-500/10 hover:-translate-y-0.5"
        >
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
            <path d="M2 12h20"></path>
          </svg>
          <span id="portfolio-label">Meu Portfólio</span>
        </a>

        <a
          id="github-btn"
          href="#"
          hidden
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-xl bg-zinc-900/90 hover:bg-zinc-800/90 text-zinc-200 border border-zinc-800 hover:border-zinc-700 font-medium text-sm transition-all duration-200 hover:-translate-y-0.5"
        >
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <span id="github-label">GitHub Pessoal</span>
        </a>
      </nav>

      <!-- Easter egg: remova `hidden` no DevTools -->
      <div
        id="hacker-secret"
        data-easter-egg="Opa, xeretando o HTML? Remova o atributo 'hidden' deste elemento..."
        hidden
        class="mt-12 pt-6 border-t border-zinc-900/80"
      >
        <button
          id="hacker-trigger"
          type="button"
          commandfor="hacker-dialog"
          command="show-modal"
          class="group inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-mono text-zinc-500 hover:text-zinc-200 hover:bg-zinc-900/60 transition-colors cursor-pointer"
        >
          <span class="accent-text group-hover:translate-x-0.5 transition-transform">&gt;_</span>
          <span id="hacker-trigger-text">Estava tentando me hackear?</span>
        </button>
      </div>
    </main>

    <dialog id="hacker-dialog" closedby="any" aria-labelledby="hacker-dialog-title">
      <div class="overflow-hidden rounded-2xl bg-zinc-950 text-left">
        <div class="flex items-center justify-between px-4 py-3 bg-zinc-900/90 border-b border-zinc-800">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
            <h2 id="hacker-dialog-title" class="ml-2 text-xs font-mono text-zinc-400">
              honeypot@falcon:~#
            </h2>
          </div>
          <button
            type="button"
            commandfor="hacker-dialog"
            command="close"
            aria-label="Fechar modal"
            class="text-zinc-500 hover:text-zinc-200 transition-colors p-1 rounded-md hover:bg-zinc-800 cursor-pointer"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <div class="p-6 space-y-4 font-mono text-sm">
          <div class="flex items-start gap-3">
            <span id="hacker-emoji" class="text-2xl select-none shrink-0" aria-hidden="true">🕵️‍♂️</span>
            <p id="hacker-message" class="text-zinc-300 leading-relaxed">
              Boa tentativa! Tirar o atributo 'hidden' no DevTools não conta como zero-day, mas ganhou pontos pela curiosidade.
            </p>
          </div>

          <div id="hacker-image-wrapper" hidden class="pt-2">
            <img
              id="hacker-image"
              src=""
              alt="Easter egg"
              loading="lazy"
              class="w-full max-h-60 object-cover rounded-lg border border-zinc-800"
            />
          </div>

          <div class="pt-2 flex justify-end">
            <button
              type="button"
              commandfor="hacker-dialog"
              command="close"
              class="px-3.5 py-1.5 rounded-lg bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-xs text-zinc-300 transition-colors cursor-pointer"
            >
              Prometo me comportar
            </button>
          </div>
        </div>
      </div>
    </dialog>

    <script>
      import type { AppConfig } from '../types/config';

      const DEFAULT_SUBTITLE =
        'O endereço que você buscou não existe ou eu quebrei alguma coisa!';

      const LEGACY_DEFAULT_TEMPLATE =
        'Parece que você se perdeu, o endereço que você buscou {domain} não existe ou eu quebrei alguma coisa!';

      const THEMES = [
        { accent: '#10b981', glow: 'rgba(16, 185, 129, 0.42)', soft: 'rgba(16, 185, 129, 0.14)' }, // Emerald
        { accent: '#06b6d4', glow: 'rgba(6, 182, 212, 0.42)',  soft: 'rgba(6, 182, 212, 0.14)' },  // Cyan
        { accent: '#8b5cf6', glow: 'rgba(139, 92, 246, 0.45)', soft: 'rgba(139, 92, 246, 0.15)' }, // Violet
        { accent: '#f43f5e', glow: 'rgba(244, 63, 94, 0.42)',  soft: 'rgba(244, 63, 94, 0.14)' },  // Rose
        { accent: '#f59e0b', glow: 'rgba(245, 158, 11, 0.40)', soft: 'rgba(245, 158, 11, 0.14)' }, // Amber
        { accent: '#3b82f6', glow: 'rgba(59, 130, 246, 0.45)', soft: 'rgba(59, 130, 246, 0.15)' }, // Blue
        { accent: '#d946ef', glow: 'rgba(217, 70, 239, 0.42)', soft: 'rgba(217, 70, 239, 0.14)' }, // Fuchsia
      ];

      function randomizeTheme(): string {
        const prevIdx = Number(sessionStorage.getItem('glowIdx') ?? -1);
        let nextIdx = Math.floor(Math.random() * THEMES.length);
        if (nextIdx === prevIdx) {
          nextIdx = (nextIdx + 1) % THEMES.length;
        }

        sessionStorage.setItem('glowIdx', String(nextIdx));
        const theme = THEMES[nextIdx];
        const root = document.documentElement;
        root.style.setProperty('--accent', theme.accent);
        root.style.setProperty('--accent-glow', theme.glow);
        root.style.setProperty('--accent-soft', theme.soft);
        return theme.accent;
      }

      function getCurrentDomain(): string {
        const host = window.location.host || 'desconhecido';
        const path = window.location.pathname && window.location.pathname !== '/' ? window.location.pathname : '';
        return `${host}${path}`;
      }

      function renderMessage(template: string, domain: string): void {
        const badgeEl = document.getElementById('domain-badge');
        if (badgeEl) {
          badgeEl.textContent = domain;
        }

        const msgEl = document.getElementById('error-message');
        if (!msgEl) return;

        const trimmed = template.trim();
        if (!trimmed || trimmed === LEGACY_DEFAULT_TEMPLATE) {
          msgEl.textContent = DEFAULT_SUBTITLE;
          return;
        }

        msgEl.textContent = trimmed.replace('{domain}', domain);
      }

      function levenshtein(a: string, b: string): number {
        const dp = Array.from({ length: a.length + 1 }, (_, i) =>
          Array.from({ length: b.length + 1 }, (_, j) => (i === 0 ? j : j === 0 ? i : 0))
        );
        for (let i = 1; i <= a.length; i++) {
          for (let j = 1; j <= b.length; j++) {
            dp[i][j] =
              a[i - 1] === b[j - 1]
                ? dp[i - 1][j - 1]
                : 1 + Math.min(dp[i - 1][j], dp[i][j - 1], dp[i - 1][j - 1]);
          }
        }
        return dp[a.length][b.length];
      }

      function checkTypoSuggestion(portfolioUrl: string, githubUrl: string): void {
        const wrapper = document.getElementById('typo-wrapper');
        const linkEl = document.getElementById('typo-link') as HTMLAnchorElement | null;
        const targetEl = document.getElementById('typo-target');
        if (!wrapper || !linkEl || !targetEl) return;

        const sub = window.location.hostname.split('.')[0]?.toLowerCase() || '';
        const pathSeg = window.location.pathname.split('/').filter(Boolean)[0]?.toLowerCase() || '';
        const query = sub && sub !== 'localhost' && sub !== 'www' ? sub : pathSeg;

        if (!query || query.length < 3) {
          wrapper.hidden = true;
          return;
        }

        const candidates: Array<{ keyword: string; label: string; url: string }> = [];

        if (portfolioUrl) {
          try {
            const parsed = new URL(portfolioUrl);
            const kw = parsed.hostname.split('.')[0].toLowerCase();
            candidates.push({ keyword: kw, label: parsed.hostname, url: portfolioUrl });
          } catch {
            // URL inválida ignorada
          }
        }

        if (githubUrl) {
          candidates.push({ keyword: 'github', label: 'GitHub', url: githubUrl });
          candidates.push({ keyword: 'git', label: 'GitHub', url: githubUrl });
        }

        for (const item of candidates) {
          const dist = levenshtein(query, item.keyword);
          const isClose =
            dist <= 3 ||
            (query.length >= 3 && item.keyword.includes(query)) ||
            (item.keyword.length >= 3 && query.includes(item.keyword));

          if (isClose) {
            linkEl.href = item.url;
            targetEl.textContent = item.label;
            wrapper.hidden = false;
            return;
          }
        }

        wrapper.hidden = true;
      }

      function applyConfig(config: AppConfig): void {
        const domain = getCurrentDomain();
        renderMessage(config.messageTemplate || DEFAULT_SUBTITLE, domain);

        const linksSection = document.getElementById('links-section');
        const portfolioBtn = document.getElementById('portfolio-btn') as HTMLAnchorElement | null;
        const portfolioLabel = document.getElementById('portfolio-label');
        const githubBtn = document.getElementById('github-btn') as HTMLAnchorElement | null;
        const githubLabel = document.getElementById('github-label');

        const portfolioUrl = config.portfolioUrl?.trim() || '';
        const githubUrl = config.githubUrl?.trim() || '';

        checkTypoSuggestion(portfolioUrl, githubUrl);

        let hasAnyLink = false;

        if (portfolioBtn && portfolioUrl) {
          portfolioBtn.href = portfolioUrl;
          if (portfolioLabel && config.portfolioLabel?.trim()) {
            portfolioLabel.textContent = config.portfolioLabel.trim();
          }
          portfolioBtn.hidden = false;
          hasAnyLink = true;
        } else if (portfolioBtn) {
          portfolioBtn.hidden = true;
        }

        if (githubBtn && githubUrl) {
          githubBtn.href = githubUrl;
          if (githubLabel && config.githubLabel?.trim()) {
            githubLabel.textContent = config.githubLabel.trim();
          }
          githubBtn.hidden = false;
          hasAnyLink = true;
        } else if (githubBtn) {
          githubBtn.hidden = true;
        }

        if (linksSection) {
          linksSection.hidden = !hasAnyLink;
        }

        const triggerTextEl = document.getElementById('hacker-trigger-text');
        const emojiEl = document.getElementById('hacker-emoji');
        const messageEl = document.getElementById('hacker-message');
        const imageWrapper = document.getElementById('hacker-image-wrapper');
        const imageEl = document.getElementById('hacker-image') as HTMLImageElement | null;

        if (triggerTextEl && config.hackerTriggerText?.trim()) {
          triggerTextEl.textContent = config.hackerTriggerText.trim();
        }
        if (emojiEl && config.hackerEmoji?.trim()) {
          emojiEl.textContent = config.hackerEmoji.trim();
        }
        if (messageEl && config.hackerMessage?.trim()) {
          messageEl.textContent = config.hackerMessage.trim();
        }
        if (imageWrapper && imageEl) {
          const imgUrl = config.hackerImageUrl?.trim() || '';
          if (imgUrl) {
            imageEl.src = imgUrl;
            imageWrapper.hidden = false;
          } else {
            imageWrapper.hidden = true;
          }
        }
      }

      function setupDialogFallbacks(): void {
        const dialog = document.getElementById('hacker-dialog') as HTMLDialogElement | null;
        if (!dialog) return;

        // Fallback: Invoker Commands
        if (!('commandForElement' in HTMLButtonElement.prototype)) {
          document.addEventListener('click', (event) => {
            const btn = (event.target as Element | null)?.closest?.('button[commandfor]') as HTMLButtonElement | null;
            if (!btn) return;
            const targetId = btn.getAttribute('commandfor');
            const cmd = btn.getAttribute('command');
            if (targetId !== 'hacker-dialog') return;

            if (cmd === 'show-modal' && !dialog.open) {
              dialog.showModal();
            } else if (cmd === 'close' && dialog.open) {
              dialog.close();
            }
          });
        }

        // Fallback: light-dismiss
        if (!('closedBy' in HTMLDialogElement.prototype)) {
          dialog.addEventListener('click', (event) => {
            if (event.target !== dialog) return;
            const rect = dialog.getBoundingClientRect();
            const isDialogContent =
              rect.top <= event.clientY &&
              event.clientY <= rect.top + rect.height &&
              rect.left <= event.clientX &&
              event.clientX <= rect.left + rect.width;
            if (isDialogContent) return;
            dialog.close();
          });
        }
      }

      async function init(): Promise<void> {
        randomizeTheme();
        renderMessage(DEFAULT_SUBTITLE, getCurrentDomain());
        setupDialogFallbacks();

        try {
          const res = await fetch('/config.json', { cache: 'no-store' });
          if (res.ok) {
            const jsonConfig = (await res.json()) as AppConfig;
            applyConfig(jsonConfig);
            return;
          }
        } catch {
          // Usa defaults locais
        }

        applyConfig({});
      }

      init();
    </script>
  </body>
</html>
