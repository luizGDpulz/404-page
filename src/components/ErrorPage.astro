---
import '../styles/global.css';
import { getAppEnvConfig } from '../config/env';
import { CHAMELEON_THEMES, ERROR_SPECS, type ErrorCode } from '../config/errors';

interface Props {
  status: ErrorCode;
}

const { status } = Astro.props;
const spec = ERROR_SPECS[status];
const env = getAppEnvConfig();
const showActionsNav = spec.showRetryButton || env.hasAnyLink;
---

<!doctype html>
<html lang="pt-BR" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{spec.pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline define:vars={{ fixedTheme: spec.fixedTheme ?? null, themes: CHAMELEON_THEMES }}>
      (function () {
        var theme = fixedTheme;
        if (!theme) {
          var prevIdx = Number(sessionStorage.getItem('glowIdx') ?? -1);
          var nextIdx = Math.floor(Math.random() * themes.length);
          if (nextIdx === prevIdx) {
            nextIdx = (nextIdx + 1) % themes.length;
          }
          sessionStorage.setItem('glowIdx', String(nextIdx));
          theme = themes[nextIdx];
        }
        var root = document.documentElement;
        root.style.setProperty('--accent', theme.accent);
        root.style.setProperty('--accent-glow', theme.glow);
        root.style.setProperty('--accent-soft', theme.soft);
        window.__CURRENT_ACCENT__ = theme.accent;
      })();
    </script>
  </head>

  <body
    data-allow-typo={spec.allowTypoSuggestion ? 'true' : 'false'}
    class="min-h-dvh flex flex-col items-center justify-center relative px-4 py-12"
  >
    <div
      id="bg-glow"
      aria-hidden="true"
      class="pointer-events-none fixed top-1/2 left-1/2 w-[26rem] h-[26rem]"
    ></div>

    <main class="relative z-10 w-full max-w-xl text-center animate-content-fade-in">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-900/90 border border-zinc-800 text-xs font-mono text-zinc-400 mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full accent-dot animate-pulse"></span>
        <span>{spec.badgeText}</span>
      </div>

      <h1 class="text-8xl sm:text-9xl font-black tracking-tighter bg-gradient-to-b from-white via-zinc-200 to-zinc-600 bg-clip-text text-transparent select-none leading-none transition-transform duration-500 ease-out hover:scale-[1.03]">
        {spec.code}
      </h1>

      <h2 class="mt-5 text-xl sm:text-2xl font-semibold tracking-tight text-zinc-100">
        {spec.headline}
      </h2>

      <div class="mt-4 flex flex-col items-center">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-zinc-900/90 border border-zinc-800 font-mono text-xs sm:text-sm max-w-full shadow-sm">
          <span class="text-zinc-500 select-none font-semibold">GET</span>
          <code id="domain-badge" class="accent-text font-medium break-all"></code>
          <script is:inline>
            (function () {
              var host = window.location.host || 'desconhecido';
              var path = window.location.pathname && window.location.pathname !== '/' ? window.location.pathname : '';
              var el = document.getElementById('domain-badge');
              if (el) el.textContent = host + path;
            })();
          </script>
        </div>

        {spec.allowTypoSuggestion && (
          <div id="typo-wrapper" hidden class="mt-2.5">
            <a
              id="typo-link"
              href="#"
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-zinc-900/60 hover:bg-zinc-900 border border-zinc-800/80 accent-border-hover text-xs text-zinc-400 hover:text-zinc-200 transition-all"
            >
              <span>💡 Quis dizer</span>
              <span id="typo-target" class="font-mono accent-text font-medium underline underline-offset-2"></span>
              <span>?</span>
            </a>
          </div>
        )}
      </div>

      <p
        id="error-message"
        class="mt-4 text-sm sm:text-base text-zinc-400 leading-relaxed max-w-md mx-auto"
      >
        {spec.description}
      </p>

      {showActionsNav && (
        <nav
          id="links-section"
          aria-label="Ações disponíveis"
          class="mt-9 flex flex-wrap items-center justify-center gap-3.5"
        >
          {spec.showRetryButton && (
            <button
              id="retry-btn"
              type="button"
              class="animate-fade-in-up inline-flex items-center gap-2.5 px-5 py-2.5 rounded-xl bg-zinc-100 hover:bg-white text-zinc-950 font-medium text-sm transition-all duration-200 shadow-sm hover:-translate-y-0.5 cursor-pointer"
            >
              <svg
                id="retry-icon"
                class="w-4 h-4 shrink-0 transition-transform duration-300"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path>
                <path d="M21 3v5h-5"></path>
              </svg>
              <span id="retry-label">Tentar novamente</span>
            </button>
          )}

          {env.hasPortfolio && (
            <a
              id="portfolio-btn"
              href={env.portfolioUrl}
              rel="noopener noreferrer"
              class:list={[
                'animate-fade-in-up inline-flex items-center gap-2.5 px-5 py-2.5 rounded-xl font-medium text-sm transition-all duration-200 hover:-translate-y-0.5',
                spec.showRetryButton
                  ? 'bg-zinc-900/90 hover:bg-zinc-800/90 text-zinc-200 border border-zinc-800 hover:border-zinc-700 [animation-delay:240ms]'
                  : 'bg-zinc-100 hover:bg-white text-zinc-950 shadow-sm hover:shadow-emerald-500/10'
              ]}
            >
              <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
                <path d="M2 12h20"></path>
              </svg>
              <span id="portfolio-label">{env.portfolioLabel}</span>
            </a>
          )}

          {env.hasGithub && (
            <a
              id="github-btn"
              href={env.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class:list={[
                'animate-fade-in-up inline-flex items-center gap-2.5 px-5 py-2.5 rounded-xl bg-zinc-900/90 hover:bg-zinc-800/90 text-zinc-200 border border-zinc-800 hover:border-zinc-700 font-medium text-sm transition-all duration-200 hover:-translate-y-0.5',
                spec.showRetryButton
                  ? (env.hasPortfolio ? '[animation-delay:300ms]' : '[animation-delay:240ms]')
                  : (env.hasPortfolio && '[animation-delay:260ms]')
              ]}
            >
              <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
              <span id="github-label">{env.githubLabel}</span>
            </a>
          )}
        </nav>
      )}

      <!-- Easter egg: remova `hidden` no DevTools -->
      <div
        id="hacker-secret"
        data-easter-egg="Opa, xeretando o HTML? Remova o atributo 'hidden' deste elemento..."
        hidden
        class="mt-12 pt-6 border-t border-zinc-900/80"
      >
        <button
          id="hacker-trigger"
          type="button"
          commandfor="hacker-dialog"
          command="show-modal"
          class="group inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-mono text-zinc-500 hover:text-zinc-200 hover:bg-zinc-900/60 transition-colors cursor-pointer"
        >
          <span class="accent-text group-hover:translate-x-0.5 transition-transform">&gt;_</span>
          <span id="hacker-trigger-text">{env.hackerTriggerText}</span>
        </button>
      </div>
    </main>

    <dialog id="hacker-dialog" closedby="any" aria-labelledby="hacker-dialog-title">
      <div class="overflow-hidden rounded-2xl bg-zinc-950 text-left">
        <div class="flex items-center justify-between px-4 py-3 bg-zinc-900/90 border-b border-zinc-800">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
            <h2 id="hacker-dialog-title" class="ml-2 text-xs font-mono text-zinc-400">
              honeypot@falcon:~#
            </h2>
          </div>
          <button
            type="button"
            commandfor="hacker-dialog"
            command="close"
            aria-label="Fechar modal"
            class="text-zinc-500 hover:text-zinc-200 transition-colors p-1 rounded-md hover:bg-zinc-800 cursor-pointer"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <div class="p-6 space-y-4 font-mono text-sm">
          <div class="flex items-start gap-3">
            <span id="hacker-emoji" class="text-2xl select-none shrink-0" aria-hidden="true">{env.hackerEmoji}</span>
            <p id="hacker-message" class="text-zinc-300 leading-relaxed">
              {env.hackerMessage}
            </p>
          </div>

          {env.hackerImageUrl && (
            <div id="hacker-image-wrapper" class="pt-2">
              <img
                id="hacker-image"
                src={env.hackerImageUrl}
                alt="Easter egg"
                loading="lazy"
                class="w-full max-h-60 object-cover rounded-lg border border-zinc-800"
              />
            </div>
          )}

          <div class="pt-2 flex justify-end">
            <button
              type="button"
              commandfor="hacker-dialog"
              command="close"
              class="px-3.5 py-1.5 rounded-lg bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-xs text-zinc-300 transition-colors cursor-pointer"
            >
              Prometo me comportar
            </button>
          </div>
        </div>
      </div>
    </dialog>

    <script>
      function levenshtein(a: string, b: string): number {
        const dp = Array.from({ length: a.length + 1 }, (_, i) =>
          Array.from({ length: b.length + 1 }, (_, j) => (i === 0 ? j : j === 0 ? i : 0))
        );
        for (let i = 1; i <= a.length; i++) {
          for (let j = 1; j <= b.length; j++) {
            dp[i][j] =
              a[i - 1] === b[j - 1]
                ? dp[i - 1][j - 1]
                : 1 + Math.min(dp[i - 1][j], dp[i][j - 1], dp[i - 1][j - 1]);
          }
        }
        return dp[a.length][b.length];
      }

      function checkTypoSuggestion(portfolioUrl: string, githubUrl: string): void {
        const wrapper = document.getElementById('typo-wrapper');
        const linkEl = document.getElementById('typo-link') as HTMLAnchorElement | null;
        const targetEl = document.getElementById('typo-target');
        if (!wrapper || !linkEl || !targetEl) return;

        const sub = window.location.hostname.split('.')[0]?.toLowerCase() || '';
        const pathSeg = window.location.pathname.split('/').filter(Boolean)[0]?.toLowerCase() || '';
        const query = sub && sub !== 'localhost' && sub !== 'www' ? sub : pathSeg;

        if (!query || query.length < 3) {
          wrapper.hidden = true;
          return;
        }

        const candidates: Array<{ keyword: string; label: string; url: string }> = [];

        if (portfolioUrl) {
          try {
            const parsed = new URL(portfolioUrl, window.location.origin);
            const kw = parsed.hostname.split('.')[0].toLowerCase();
            candidates.push({ keyword: kw, label: parsed.hostname, url: portfolioUrl });
          } catch {
            // URL inválida ignorada
          }
        }

        if (githubUrl) {
          candidates.push({ keyword: 'github', label: 'GitHub', url: githubUrl });
          candidates.push({ keyword: 'git', label: 'GitHub', url: githubUrl });
        }

        for (const item of candidates) {
          const dist = levenshtein(query, item.keyword);
          const isClose =
            dist <= 3 ||
            (query.length >= 3 && item.keyword.includes(query)) ||
            (item.keyword.length >= 3 && query.includes(item.keyword));

          if (isClose) {
            linkEl.href = item.url;
            targetEl.textContent = item.label;
            wrapper.hidden = false;
            return;
          }
        }

        wrapper.hidden = true;
      }

      function setupRetryButton(): void {
        const retryBtn = document.getElementById('retry-btn') as HTMLButtonElement | null;
        const retryIcon = document.getElementById('retry-icon');
        const retryLabel = document.getElementById('retry-label');
        if (!retryBtn) return;

        retryBtn.addEventListener('click', () => {
          retryBtn.disabled = true;
          retryIcon?.classList.add('animate-spin');
          if (retryLabel) retryLabel.textContent = 'Reconectando...';
          window.location.reload();
        });
      }

      function setupDialogFallbacks(): void {
        const dialog = document.getElementById('hacker-dialog') as HTMLDialogElement | null;
        if (!dialog) return;

        if (!('commandForElement' in HTMLButtonElement.prototype)) {
          document.addEventListener('click', (event) => {
            const btn = (event.target as Element | null)?.closest?.('button[commandfor]') as HTMLButtonElement | null;
            if (!btn) return;
            const targetId = btn.getAttribute('commandfor');
            const cmd = btn.getAttribute('command');
            if (targetId !== 'hacker-dialog') return;

            if (cmd === 'show-modal' && !dialog.open) {
              dialog.showModal();
            } else if (cmd === 'close' && dialog.open) {
              dialog.close();
            }
          });
        }

        if (!('closedBy' in HTMLDialogElement.prototype)) {
          dialog.addEventListener('click', (event) => {
            if (event.target !== dialog) return;
            const rect = dialog.getBoundingClientRect();
            const isDialogContent =
              rect.top <= event.clientY &&
              event.clientY <= rect.top + rect.height &&
              rect.left <= event.clientX &&
              event.clientX <= rect.left + rect.width;
            if (isDialogContent) return;
            dialog.close();
          });
        }
      }

      function setupHackerConsole(accent: string): void {
        console.log(
          '%c 🚨 OPA, XERETA DETECTADO! ',
          `background: ${accent}; color: #09090b; font-weight: 800; font-family: monospace; font-size: 14px; padding: 4px 8px; border-radius: 6px;`
        );
        console.log(
          '%cAbriu o F12 achando que ia achar um .env dando sopa ou a senha do banco em texto puro, né safado(a)? 😂\nJá que a coceira na mão tá grande, vai lá na aba Elements e tira o atributo %chidden%c do elemento secreto no HTML, seu curioso!',
          'color: #d4d4d8; font-family: monospace; font-size: 12px; line-height: 1.6;',
          `color: ${accent}; font-weight: bold; font-family: monospace; font-size: 12px;`,
          'color: #d4d4d8; font-family: monospace; font-size: 12px; line-height: 1.6;'
        );

        const secretEl = document.getElementById('hacker-secret');
        if (!secretEl) return;

        const observer = new MutationObserver(() => {
          if (!secretEl.hasAttribute('hidden')) {
            console.log(
              '%c👀 Olha só, sabe mesmo mexer no DOM! O botão secreto apareceu lá no rodapé da página. Clica nele se tiver coragem...',
              `color: ${accent}; font-family: monospace; font-weight: bold; font-size: 12px;`
            );
            observer.disconnect();
          }
        });

        observer.observe(secretEl, { attributes: true, attributeFilter: ['hidden'] });
      }

      function init(): void {
        const accent = (window as unknown as { __CURRENT_ACCENT__?: string }).__CURRENT_ACCENT__ || '#10b981';
        setupHackerConsole(accent);
        setupDialogFallbacks();
        setupRetryButton();

        if (document.body.dataset.allowTypo === 'true') {
          const portfolioBtn = document.getElementById('portfolio-btn') as HTMLAnchorElement | null;
          const githubBtn = document.getElementById('github-btn') as HTMLAnchorElement | null;
          checkTypoSuggestion(
            portfolioBtn?.getAttribute('href') || '',
            githubBtn?.getAttribute('href') || ''
          );
        }
      }

      init();
    </script>
  </body>
</html>
